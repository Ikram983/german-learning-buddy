LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternative provider (set LLM_PROVIDER=openai to use these instead)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_MODEL=all-MiniLM-L6-v2
COLLECTION_NAME=german_buddy
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
